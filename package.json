		"style-loader": "^4.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.8.2",
		"webpack": "^5.75.0",
		"webpack-cli": "^5.0.0",
		"webpack-dev-server": "^5.2.3"
	}
